#. module: pos_order_new_line
#: model:ir.model.fields,help:pos_order_new_line.field_pos_config__order_add_new_line
msgid "If checked, a new button will be added to the POS order screen to add a new line to the current order instead of updating the existing line."
msgstr "Se selezionato, verrà aggiunto un nuovo pulsante allo schermo dell'ordine POS per aggiungere una nuova riga all'ordine corrente invece di aggiornare la riga esistente."

#. module: pos_order_new_line
#: code:addons/pos_order_new_line/views/pos_config.xml:0
msgid "Add New Line to Order"
msgstr "Aggiungi nuova riga all'ordine"

#. module: pos_order_new_line
#: code:addons/pos_order_new_line/views/pos_config.xml:0
msgid "Allow cashier to create a new order line, instead of merging the quantity with a previous line"
msgstr "Consenti al cassiere di creare una nuova riga di ordine, invece di unire la quantità con una riga precedente"

#. module: pos_order_new_line
#: code:addons/pos_order_new_line/views/pos_config.xml:0
msgid "Enable New Line Button"
msgstr "Abilita pulsante Nuova riga"
